@@ -673,6 +673,9 @@ fn run_jit_helper_stdio() -> eyre::Result<()> {
     let pool = ThreadPoolBuilder::new()
         .num_threads(worker_count)
         .thread_name(|i| format!("revmc-helper-{i:02}"))
+        // Same LLVM-codegen stack-depth concern as the in-process worker pool
