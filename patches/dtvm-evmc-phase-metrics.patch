+void expectActiveTimeConsistent(const dtvm_evmc_hot_metrics &Metrics) {
+  EXPECT_LE(Metrics.jit_active_wall_ns + Metrics.interpreter_active_wall_ns,
+            Metrics.top_level_execute_wall_ns);
+}
+#endif
