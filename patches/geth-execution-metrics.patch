+}
+
+// ExecuteStatelessWithMetrics runs ExecuteStateless and records its three
+// non-overlapping phases. The ordinary execution path remains uninstrumented.
+func ExecuteStatelessWithMetrics(ctx context.Context, config *params.ChainConfig, vmconfig vm.Config, block *types.Block, witness *stateless.Witness) (common.Hash, common.Hash, StatelessExecutionMetrics, error) {
+	var metrics StatelessExecutionMetrics
+	stateRoot, receiptRoot, err := executeStateless(ctx, config, vmconfig, block, witness, &metrics)
+	return stateRoot, receiptRoot, metrics, err
+}
+
+func executeStateless(ctx context.Context, config *params.ChainConfig, vmconfig vm.Config, block *types.Block, witness *stateless.Witness, metrics *StatelessExecutionMetrics) (common.Hash, common.Hash, error) {
+	phaseStarted := time.Time{}
+	if metrics != nil {
+		phaseStarted = time.Now()
+	}
 	// Sanity check if the supplied block accidentally contains a set root or
 	// receipt hash. If so, be very loud, but still continue.
 	if block.Root() != (common.Hash{}) {
@@ -66,17 +93,42 @@ func ExecuteStateless(ctx context.Context, config *params.ChainConfig, vmconfig
 	}
 	processor := NewStateProcessor(chain)
 	validator := NewBlockValidator(config, nil) // No chain, we only validate the state, not the block
+	if metrics != nil {
+		metrics.Setup = time.Since(phaseStarted)
+		phaseStarted = time.Now()
+	}
 
 	// Run the stateless blocks processing and self-validate certain fields
 	res, err := processor.Process(ctx, block, db, nil, vmconfig)
 	if err != nil {
 		return common.Hash{}, common.Hash{}, err
 	}
+	if metrics != nil {
+		metrics.Execution = time.Since(phaseStarted)
+		phaseStarted = time.Now()
+	}
 	if err = validator.ValidateState(block, db, res, true); err != nil {
 		return common.Hash{}, common.Hash{}, err
 	}
+	// Validate Prague execution requests explicitly. ValidateState returns
+	// early in stateless mode before this check because state and receipt roots
+	// are returned to the caller.
+	if block.RequestsHash() != nil {
+		requestHash := types.CalcRequestsHash(res.Requests)
+		if requestHash != *block.RequestsHash() {
+			return common.Hash{}, common.Hash{}, fmt.Errorf("invalid requests hash (remote: %x local: %x)", *block.RequestsHash(), requestHash)
+		}
+	} else if res.Requests != nil {
+		return common.Hash{}, common.Hash{}, errors.New("block has requests before prague fork")
+	}
 	// Almost everything validated, but receipt and state root needs to be returned
 	receiptRoot := types.DeriveSha(res.Receipts, trie.NewStackTrie(nil))
 	stateRoot := db.IntermediateRoot(config.IsEIP158(block.Number()))
+	if err := db.Error(); err != nil {
+		return common.Hash{}, common.Hash{}, fmt.Errorf("stateless database access failed: %w", err)
+	}
+	if metrics != nil {
+		metrics.Validation = time.Since(phaseStarted)
+	}
 	return stateRoot, receiptRoot, nil
 }
